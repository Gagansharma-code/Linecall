# Roboflow API key from your own Roboflow account (free tier is enough).
# Create one at https://app.roboflow.com/settings/api
# Copy this file to .env and fill in the value. Never hardcode the key
# and never commit .env.
ROBOFLOW_API_KEY=

# Absolute path to raw amateur/public-court footage on THIS machine.
# Deliberately kept outside the repo and outside any cloud-synced folder
# (OneDrive/Dropbox/etc.) — these are large raw video files with no reason
# to be versioned or cloud-synced, and this path is machine-specific by
# nature, so it belongs in .env, not in a committed config file.
# Example (Windows): AMATEUR_FOOTAGE_DIR=C:\linecall-data\amateur_footage_raw
AMATEUR_FOOTAGE_DIR=
