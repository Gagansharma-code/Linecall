# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# Secrets — never commit a real key
.env

# IDE
.idea/
.vscode/
*.swp
*~

# Tests / tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Dataset contents stay local; keep the directory itself
data/*
!data/.gitkeep

# Future training output (dirs created by later tickets)
runs/
models/
replays/

# Pretrained/fine-tuned model checkpoints — never commit weights, whatever
# directory they land in (Ultralytics downloads base checkpoints to the CWD)
*.pt
*.pth
*.onnx

# PNNX / NCNN tooling Ultralytics may drop in the repo root on first export
pnnx
pnnx.exe
debug.bin
debug.param
debug2.bin
debug2.param

# OS
.DS_Store
Thumbs.db
